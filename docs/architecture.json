{
  "title": "mjpegZero encoder (mjpegzero_enc_top)",
  "subtitle": "8x8 blocks in MCU order (Y0 Y1 Cb Cr, 4:2:2) · one 150 MHz clock domain · Verilog 2001 and VHDL-1993",
  "notes": ["JPEG output has no backpressure: the sink must accept every byte (add a 256-512 B FIFO if it can stall)."],
  "top": "mjpegzero_enc_top",
  "theme": "auto",
  "grid": {"cell_w": 220, "cell_h": 96, "gutter_x": 110, "gutter_y": 100, "margin": 40},
  "domains": {
    "core": {"freq_mhz": 150}
  },
  "roles": {
    "transform": {"label": "Pixels to coefficients"},
    "control":   {"label": "Registers and frame control"},
    "entropy":   {"label": "Entropy coding to JFIF"}
  },
  "blocks": [
    {"id": "video_in", "lines": ["Video in", "AXI4-Stream slave", "16b YUYV / 24b RGB"],
     "external": true, "side": "left", "row": 0, "col": 0},
    {"id": "rgb2yuv", "lines": ["rgb_to_ycbcr", "BT.601 RGB to YUYV", "only if RGB_INPUT=1"],
     "mono": true, "optional": true, "role": "transform", "domain": "core", "row": 0, "col": 1},
    {"id": "ibuf", "lines": ["input_buffer", "8-line strip BRAM", "YUYV to 8x8 blocks"],
     "mono": true, "role": "transform", "domain": "core", "row": 0, "col": 2},
    {"id": "dct", "lines": ["dct_2d", "row/column 1-D DCT", "+ transpose buffer"],
     "mono": true, "role": "transform", "domain": "core", "row": 0, "col": 3},
    {"id": "quant", "lines": ["quantizer", "reciprocal multiply", "Q tables from QUALITY"],
     "mono": true, "role": "transform", "domain": "core", "row": 0, "col": 4},

    {"id": "host", "lines": ["Host", "AXI4-Lite master", "32b data, 5b addr"],
     "external": true, "side": "left", "row": 1, "col": 0},
    {"id": "regs", "lines": ["axi4_lite_regs", "CTRL / STATUS / QUALITY", "RESTART / FRAME_CNT/SIZE"],
     "mono": true, "role": "control", "domain": "core", "row": 1, "col": 1},
    {"id": "fsm", "lines": ["frame control", "IDLE > QWAIT > RUN > DRAIN",
                            "latches QUALITY/RESTART per frame",
                            "<= HUFF_BANKS blocks in flight"],
     "role": "control", "domain": "core", "row": 1, "col": 2, "w": 550, "h": 110},

    {"id": "jpeg_out", "lines": ["JPEG out", "AXI4-Stream master", "8b, no tready"],
     "external": true, "side": "left", "row": 2, "col": 0},
    {"id": "jfif", "lines": ["jfif_writer", "SOI APP0 DQT SOF0", "DHT SOS ... EOI"],
     "mono": true, "role": "entropy", "domain": "core", "row": 2, "col": 1},
    {"id": "packer", "lines": ["bitstream_packer", "bits to bytes", "FF to FF 00 stuffing"],
     "mono": true, "role": "entropy", "domain": "core", "row": 2, "col": 2},
    {"id": "huff", "lines": ["huffman_encoder", "standard DC/AC tables", "HUFF_BANKS-deep ring"],
     "mono": true, "role": "entropy", "domain": "core", "row": 2, "col": 3},
    {"id": "zigzag", "lines": ["zigzag_reorder", "ROM address remap", "double-buffered"],
     "mono": true, "role": "entropy", "domain": "core", "row": 2, "col": 4}
  ],
  "edges": [
    {"from": "video_in", "to": "rgb2yuv", "kind": "axi-stream", "label": "16/24b"},
    {"from": "rgb2yuv", "to": "ibuf", "kind": "axi-stream", "label": "16b YUYV"},
    {"from": "ibuf", "to": "dct", "kind": "generic", "label": "8b, -128"},
    {"from": "dct", "to": "quant", "kind": "generic", "width": 16},
    {"from": "quant", "to": "zigzag", "kind": "generic", "label": "16b quantized"},
    {"from": "zigzag", "to": "huff", "kind": "generic", "width": 16},
    {"from": "huff", "to": "packer", "kind": "generic", "label": "code + len"},
    {"from": "packer", "to": "jfif", "kind": "axi-stream", "label": "8b scan"},
    {"from": "jfif", "to": "jpeg_out", "kind": "axi-stream", "width": 8},

    {"from": "host", "to": "regs", "kind": "axi-lite", "width": 32},
    {"from": "regs", "to": "fsm", "kind": "control", "label": "ctrl"},
    {"from": "fsm", "to": "regs", "kind": "control", "label": "status"},

    {"from": "fsm", "to": "ibuf", "kind": "control", "net": "seq", "from_side": "top", "to_side": "bottom", "label": "blk_start"},
    {"from": "fsm", "to": "quant", "kind": "control", "net": "seq", "from_side": "top", "to_side": "bottom", "label": "quality, comp_id"},
    {"from": "fsm", "to": "jfif", "kind": "control", "net": "seq", "from_side": "bottom", "to_side": "top", "label": "start/done"},
    {"from": "fsm", "to": "packer", "kind": "control", "net": "seq", "from_side": "bottom", "to_side": "top", "label": "flush, RSTn"},
    {"from": "fsm", "to": "huff", "kind": "control", "net": "seq", "from_side": "bottom", "to_side": "top", "label": "DC reset"}
  ]
}
